# top-most EditorConfig file
root = true

# Default settings:
[*]
max_line_length = 110
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true
end_of_line = lf

[**/Migrations/**/*.cs]
generated_code = true

[*.{xml,yml,yaml,json,props,targets,csproj,slnx,code-workspace,html,liquid,tsx,jsx,ts,js,css,webmanifest,sql}]
indent_size = 2
tab_width = 2

# Specify UTF-8 without byte-order mark
[*.{csproj,locproj,nativeproj,proj,resx,slnx,vbproj}]
charset = utf-8


